rules_version = '2';

// InvestEd Firestore security rules.
//
// Deploy with:  firebase deploy --only firestore:rules
// (or paste into Firebase console → Firestore Database → Rules).
//
// Data model:
//   users/{uid}            one AppUser document per person
//   friendRequests/{id}    one pending/accepted/declined request per doc
//
// NOTE (future hardening): today any signed-in user can READ any user document,
// which is needed for username search, friend profiles, and add-by-code — but
// it also exposes fields like email and cashBalance to other authenticated
// users via a direct query. Before scaling, move private fields (email,
// portfolio) into a `users/{uid}/private/*` subcollection readable only by the
// owner, and keep only public profile fields at the top level.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /friendRequests/{requestId} {
      // Only the two people involved can see a request.
      allow read: if request.auth != null &&
        (resource.data.toUserID == request.auth.uid ||
         resource.data.fromUserID == request.auth.uid);
      // You may only send requests as yourself.
      allow create: if request.auth != null &&
        request.resource.data.fromUserID == request.auth.uid;
      // Only the recipient accepts/declines.
      allow update: if request.auth != null &&
        resource.data.toUserID == request.auth.uid;
      allow delete: if request.auth != null &&
        (resource.data.toUserID == request.auth.uid ||
         resource.data.fromUserID == request.auth.uid);
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
